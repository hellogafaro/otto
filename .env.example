# Optional: OttoLegacy Connect source builds
# `cp .env.example .env` enables OttoLegacy Connect against the production deployment.
# These are the same public identifiers baked into official release builds, not
# secrets. Remove or comment them out to build with cloud features disabled.
# Do not add server-side secrets to this file.

# Production Clerk instance. To use your own, get these from the Clerk Dashboard
# under API keys, JWT templates, and OAuth applications.
OTTO_LEGACY_CLERK_PUBLISHABLE_KEY=pk_live_Y2xlcmsudDMuY29kZXMk
OTTO_LEGACY_CLERK_JWT_TEMPLATE=ottoLegacy-relay
OTTO_LEGACY_CLERK_CLI_OAUTH_CLIENT_ID=hzxSgY2cH10sDU2r

# Optional: signed macOS passkey builds. The RP domain defaults to the Frontend API
# hostname encoded in OTTO_LEGACY_CLERK_PUBLISHABLE_KEY. Set the override only when Clerk
# returns a different RP ID or when multiple domains must be entitled.
# OTTO_LEGACY_APPLE_TEAM_ID=ABC1234567
# OTTO_LEGACY_MACOS_PROVISIONING_PROFILE=/absolute/path/to/ottoLegacy.provisionprofile
# OTTO_LEGACY_CLERK_PASSKEY_RP_DOMAINS=example.clerk.accounts.dev,clerk.example.com

# Production relay. For a self-hosted relay, `infra/relay` deploys update it
# automatically.
OTTO_LEGACY_RELAY_URL=https://relay.ottoLegacy.codes

# Optional: hosted app origin used by the CLI's out-of-band OAuth flow.
# Defaults to https://app.otto.localhost; override to test against a staging deployment.

# Public, ingest-only mobile OpenTelemetry configuration.
# OTTO_LEGACY_MOBILE_OTLP_TRACES_URL=https://api.axiom.co/v1/traces
# OTTO_LEGACY_MOBILE_OTLP_TRACES_DATASET=ottoLegacy-code-mobile-traces-dev
# OTTO_LEGACY_MOBILE_OTLP_TRACES_TOKEN=xaat-...
