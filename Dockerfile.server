# =============================================================================
# Otto Server — multi-platform Docker image
#
# Build:
#   docker buildx build -f Dockerfile.server -t otto-server .
#
# Run (use --user to match host UID/GID for volume permissions):
#   docker run --rm -p 9100:9100 \
#     --user $(id -u):$(id -g) \
#     -e HOME=/home/otto \
#     -e OTTO_SERVER_TOKEN=<secret> \
#     otto-server
#
# Run with TLS + mounted config:
#   docker run --rm -p 9100:9100 \
#     --user $(id -u):$(id -g) \
#     -e HOME=/home/otto \
#     -e OTTO_SERVER_TOKEN=<secret> \
#     -e OTTO_RPC_TLS_CERT=/certs/cert.pem \
#     -e OTTO_RPC_TLS_KEY=/certs/key.pem \
#     -v /path/to/certs:/certs:ro \
#     -v ~/.otto:/home/otto/.otto \
#     otto-server
# =============================================================================

FROM oven/bun:1.3-slim

LABEL org.opencontainers.image.source="https://github.com/hellogafaro/otto"
LABEL org.opencontainers.image.description="Otto Server — headless AI workflow server"
LABEL org.opencontainers.image.licenses="Apache-2.0"

# Install system deps + Node.js for the WebUI build and supported script runtimes.
# Pin Node to a major via NodeSource so upgrades are explicit.
ARG NODE_MAJOR=20
RUN apt-get update && \
    apt-get install -y --no-install-recommends ca-certificates git ripgrep curl gnupg && \
    curl -fsSL https://deb.nodesource.com/setup_${NODE_MAJOR}.x | bash - && \
    apt-get install -y --no-install-recommends nodejs && \
    rm -rf /var/lib/apt/lists/*

# Create non-root user (Claude Code SDK refuses to run as root).
# At runtime, override with --user $(id -u):$(id -g) to match host permissions.
RUN groupadd -r otto && \
    useradd -r -g otto -m -d /home/otto -s /bin/bash otto

WORKDIR /app

# Copy dependency manifests first for layer caching.
# `bunfig.toml` MUST be in the WORKDIR before `bun install` runs — it sets
# `linker = "hoisted"`, which is required for the WebUI / renderer build
# (transitive deps like i18next, @tiptap/*, pdfjs-dist resolve at top-level
# node_modules). Without it Bun defaults to isolated installs and the Vite
# build fails on the first transitive bare-package import.
COPY package.json bun.lock bunfig.toml ./
COPY packages/server/package.json packages/server/
COPY packages/server-core/package.json packages/server-core/
COPY packages/shared/package.json packages/shared/
COPY packages/core/package.json packages/core/
COPY packages/session-tools-core/package.json packages/session-tools-core/
COPY packages/pi-agent-server/package.json packages/pi-agent-server/
COPY packages/otto-commands/package.json packages/otto-commands/
COPY packages/otto-cli/package.json packages/otto-cli/
COPY packages/ui/package.json packages/ui/
COPY apps/electron/package.json apps/electron/
COPY apps/cli/package.json apps/cli/
COPY apps/marketing/package.json apps/marketing/
COPY apps/viewer/package.json apps/viewer/
COPY apps/webui/package.json apps/webui/
COPY apps/docs-site/package.json apps/docs-site/

RUN bun install --frozen-lockfile

# Copy source
COPY . .

# Build the Pi agent server subprocess (required by runtime-resolver.ts)
RUN bun build packages/pi-agent-server/src/index.ts \
      --outfile packages/pi-agent-server/dist/index.js --target node --format cjs

# Build web UI assets (served by the server on the RPC port).
# vite's bundler runs under Node (via shebang in vite's bin) and hits V8's
# default ~2GB heap cap on the rendering phase (>5k modules). Raise to 4GB
# so low-RAM build hosts (e.g. 4GB VPS) can complete the build.
RUN NODE_OPTIONS="--max-old-space-size=4096" bunx vite build --config apps/webui/vite.config.ts

# Pre-create .otto so Docker named volumes inherit the correct permissions.
RUN mkdir -p /home/otto/.otto

# Make app world-readable so any --user can run it. Home dir is writable for .otto.
# Use find to only touch files/dirs missing the read bit — much faster than chmod -R on the
# entire tree (node_modules alone has hundreds of thousands of entries).
RUN find /app -not -perm -o=r -exec chmod o+r {} + && \
    find /app -type d -not -perm -o=x -exec chmod o+x {} + && \
    chmod -R 777 /home/otto

USER otto

ENV OTTO_RPC_HOST=0.0.0.0
ENV OTTO_RPC_PORT=9100
ENV OTTO_WEBUI_DIR=/app/apps/webui/dist
ENV OTTO_BUNDLED_ASSETS_ROOT=/app/apps/electron

EXPOSE 9100

ENTRYPOINT ["bun", "run", "packages/server/src/index.ts"]
