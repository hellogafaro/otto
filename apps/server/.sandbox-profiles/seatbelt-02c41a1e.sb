(version 1)
; mastra-generated-profile (regenerated on every start)
(deny default (with message "mastra-sandbox"))

; Process permissions
(allow process-exec)
(allow process-fork)
(allow process-info* (target same-sandbox))
(allow signal (target same-sandbox))

; Mach IPC
(allow mach-lookup
  (global-name "com.apple.distributed_notifications@Uv3")
  (global-name "com.apple.logd")
  (global-name "com.apple.system.logger")
  (global-name "com.apple.system.notification_center")
  (global-name "com.apple.system.opendirectoryd.libinfo")
  (global-name "com.apple.system.opendirectoryd.membership")
  (global-name "com.apple.bsd.dirhelper")
  (global-name "com.apple.securityd.xpc")
  (global-name "com.apple.SecurityServer")
  (global-name "com.apple.trustd.agent")
)

; IPC
(allow ipc-posix-shm)
(allow ipc-posix-sem)

; User preferences
(allow user-preference-read)

; sysctl
(allow sysctl-read)

; Device files
(allow file-ioctl (literal "/dev/null"))
(allow file-write-data (literal "/dev/null"))
(allow file-ioctl (literal "/dev/zero"))
(allow file-write-data (literal "/dev/zero"))
(allow file-ioctl (literal "/dev/random"))
(allow file-write-data (literal "/dev/random"))
(allow file-ioctl (literal "/dev/urandom"))
(allow file-write-data (literal "/dev/urandom"))
(allow file-ioctl (literal "/dev/tty"))
(allow file-write-data (literal "/dev/tty"))

; File read access (allow all - macOS sandbox limitation)
(allow file-read*)

; File write access (restricted to workspace and temp)
(allow file-write* (subpath "/private/var/folders/b8/_466twzs07gdxlshxpvh03p40000gn/T/otto-mastra-controller-test-jnhtaW/userdata/bot-workspaces/otto-292898b4a3888ab1cea56dc3"))
(allow file-write* (subpath "/private/tmp"))
(allow file-write* (subpath "/var/folders"))
(allow file-write* (subpath "/private/var/folders"))

; Network
(allow network*)