{
  "name": "otto",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "dev": "bun --bun run --parallel --filter \"@otto/*\" dev",
    "build": "bun --bun run --cwd apps/web build",
    "check": "bun --bun biome check .",
    "format": "bun --bun biome check --write .",
    "typecheck": "bun --bun tsc --noEmit && bun --bun run --cwd apps/web typecheck",
    "test": "bun --bun vitest run",
    "test:browser": "bun --bun playwright test",
    "check:boundaries": "bun scripts/check-boundaries.ts",
    "check:consistency": "bun scripts/check-consistency.ts",
    "db:push": "bun scripts/push.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@otto/db": "workspace:*",
    "@playwright/test": "1.63.0",
    "@types/bun": "1.4.2",
    "@types/pg": "8.23.1",
    "@types/ws": "8.18.2",
    "drizzle-kit": "0.31.11",
    "embedded-postgres": "18.4.0-beta.17",
    "typescript": "~6.0.2",
    "vitest": "5.0.3",
    "ws": "8.22.0",
    "@otto/shared": "workspace:*",
    "@mastra/core": "1.75.0"
  },
  "packageManager": "bun@1.4.2",
  "engines": {
    "bun": ">=1.4.2"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "type": "module",
  "dependencies": {
    "@aws-sdk/client-s3": "3.1145.0",
    "@better-auth/drizzle-adapter": "1.7.7",
    "@hono/zod-validator": "0.9.1",
    "better-auth": "1.7.7",
    "cron-parser": "5.10.1",
    "drizzle-orm": "0.45.3",
    "hono": "4.13.12",
    "pg": "8.23.1",
    "pg-boss": "12.35.1",
    "pino": "10.3.1",
    "zod": "4.6.5"
  }
}
