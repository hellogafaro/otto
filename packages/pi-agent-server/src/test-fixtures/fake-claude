#!/usr/bin/env bun
// A fake `claude` for claude-code-provider.test.ts. It speaks just enough of the Agent SDK's
// stream-json protocol (initialize, stream events, results, MCP over control requests) and
// never touches the network. The script and the log live in its cwd: the provider hands
// `claude` a scrubbed env, so nothing else reaches it.
//
// fake-claude-script.json: { "turns": [[step, ...], ...] }, one turn per prompt (counted across
// processes). Steps: { "text": "..." }, { "tool": { "name": "read", "input": {...} } },
// { "partial": "..." } (stream some text, then hang), { "fallback": "..." } (a non-streamed message),
// { "crash": true } (exit without a result).
import { appendFileSync, existsSync, readFileSync, realpathSync } from 'node:fs';
import { join } from 'node:path';
import { randomUUID } from 'node:crypto';

const dir = process.cwd();
const logFile = join(dir, 'fake-claude-log.jsonl');
const log = (entry) => appendFileSync(logFile, JSON.stringify({ pid: process.pid, ...entry }) + '\n');
const readLog = () => existsSync(logFile) ? readFileSync(logFile, 'utf8').trim().split('\n').map((l) => JSON.parse(l)) : [];
const script = JSON.parse(readFileSync(join(dir, 'fake-claude-script.json'), 'utf8'));
const argv = process.argv.slice(2);
const arg = (name) => {
  const i = argv.findIndex((a) => a === `--${name}` || a.startsWith(`--${name}=`));
  if (i < 0) return undefined;
  return argv[i].includes('=') ? argv[i].slice(argv[i].indexOf('=') + 1) : argv[i + 1];
};
const resume = arg('resume');
const sessionId = resume ?? arg('session-id') ?? randomUUID();
log({ kind: 'spawn', argv, env: process.env, sessionId, resume });
if (resume) {
  const key = realpathSync(dir).normalize('NFC').replace(/[^a-zA-Z0-9]/g, '-');
  const file = join(process.env.CLAUDE_CONFIG_DIR, 'projects', key, `${resume}.jsonl`);
  log({ kind: 'resume', exists: existsSync(file), records: existsSync(file) ? readFileSync(file, 'utf8').trim().split('\n').map((l) => JSON.parse(l)) : [] });
}

const write = (msg) => process.stdout.write(JSON.stringify(msg) + '\n');
const pending = new Map();
let nextRequest = 0;
let nextMessage = 0;
let mcpReady = false;
let running = false;

function mcp(message) {
  const request_id = `fake-${nextRequest++}`;
  write({ type: 'control_request', request_id, request: { subtype: 'mcp_message', server_name: 'pi', message } });
  return new Promise((resolve) => pending.set(request_id, resolve));
}

const usage = { input_tokens: 10, cache_read_input_tokens: 5, cache_creation_input_tokens: 2, output_tokens: 1 };
const event = (ev) => write({ type: 'stream_event', event: ev, parent_tool_use_id: null, uuid: randomUUID(), session_id: sessionId });
const assistant = (id, content, stop_reason) =>
  write({ type: 'assistant', message: { id, type: 'message', role: 'assistant', model: 'fake', content, stop_reason, usage: { ...usage, output_tokens: 7 } }, parent_tool_use_id: null, uuid: randomUUID(), session_id: sessionId });

function streamMessage(block, deltas, stop_reason) {
  const id = `msg_fake_${process.pid}_${nextMessage++}`;
  event({ type: 'message_start', message: { id, type: 'message', role: 'assistant', model: 'fake', content: [], usage } });
  event({ type: 'content_block_start', index: 0, content_block: block });
  for (const delta of deltas) event({ type: 'content_block_delta', index: 0, delta });
  event({ type: 'content_block_stop', index: 0 });
  event({ type: 'message_delta', delta: { stop_reason }, usage: { output_tokens: 7 } });
  event({ type: 'message_stop' });
  return id;
}

async function runTurn(steps) {
  let text = '';
  for (const step of steps) {
    if (step.text) {
      const id = streamMessage({ type: 'text', text: '' }, [{ type: 'text_delta', text: step.text.slice(0, 3) }, { type: 'text_delta', text: step.text.slice(3) }], 'end_turn');
      assistant(id, [{ type: 'text', text: step.text }], 'end_turn');
      text = step.text;
    } else if (step.fallback) {
      assistant(`msg_fallback_${nextMessage++}`, [{ type: 'text', text: step.fallback }], 'end_turn');
      text = step.fallback;
    } else if (step.crash) {
      log({ kind: 'crash' });
      process.exit(3);
    } else if (step.partial) {
      event({ type: 'message_start', message: { id: `msg_partial_${nextMessage++}`, type: 'message', role: 'assistant', model: 'fake', content: [], usage } });
      event({ type: 'content_block_start', index: 0, content_block: { type: 'text', text: '' } });
      event({ type: 'content_block_delta', index: 0, delta: { type: 'text_delta', text: step.partial } });
      log({ kind: 'hanging' });
      await new Promise(() => {});
    } else if (step.tool) {
      if (!mcpReady) {
        await mcp({ jsonrpc: '2.0', id: 0, method: 'initialize', params: { protocolVersion: '2025-06-18', capabilities: {}, clientInfo: { name: 'fake-claude', version: '0' } } });
        await mcp({ jsonrpc: '2.0', method: 'notifications/initialized' });
        const list = await mcp({ jsonrpc: '2.0', id: 1, method: 'tools/list' });
        log({ kind: 'tools', tools: list.result?.tools ?? list });
        mcpReady = true;
      }
      const toolUseId = `toolu_${process.pid}_${nextMessage}`;
      const json = JSON.stringify(step.tool.input);
      const block = { type: 'tool_use', id: toolUseId, name: `mcp__pi__${step.tool.name}`, input: {} };
      const id = streamMessage(block, [{ type: 'input_json_delta', partial_json: json.slice(0, 5) }, { type: 'input_json_delta', partial_json: json.slice(5) }], 'tool_use');
      assistant(id, [{ ...block, input: step.tool.input }], 'tool_use');
      const response = await mcp({ jsonrpc: '2.0', id: 2 + nextMessage, method: 'tools/call', params: { name: step.tool.name, arguments: step.tool.input, _meta: { 'claudecode/toolUseId': toolUseId } } });
      log({ kind: 'tool_result', toolUseId, response });
    }
  }
  write({ type: 'result', subtype: 'success', is_error: false, duration_ms: 1, duration_api_ms: 1, num_turns: 1, result: text, session_id: sessionId, total_cost_usd: 0, usage, modelUsage: {}, permission_denials: [], uuid: randomUUID() });
  running = false;
}

let buffer = '';
process.stdin.on('data', (chunk) => {
  buffer += chunk;
  let nl;
  while ((nl = buffer.indexOf('\n')) >= 0) {
    const line = buffer.slice(0, nl).trim();
    buffer = buffer.slice(nl + 1);
    if (!line) continue;
    const msg = JSON.parse(line);
    if (msg.type === 'control_request') {
      log({ kind: msg.request.subtype, request: msg.request });
      const response = msg.request.subtype === 'initialize'
        ? { commands: [], agents: [], output_style: 'default', available_output_styles: ['default'], models: [], account: {} }
        : {};
      write({ type: 'control_response', response: { subtype: 'success', request_id: msg.request_id, response } });
    } else if (msg.type === 'control_response') {
      const resolve = pending.get(msg.response.request_id);
      pending.delete(msg.response.request_id);
      resolve?.(msg.response.response?.mcp_response ?? msg.response);
    } else if (msg.type === 'user' && running) {
      log({ kind: 'steer', priority: msg.priority, message: msg.message });
    } else if (msg.type === 'user') {
      const turn = readLog().filter((e) => e.kind === 'prompt').length;
      log({ kind: 'prompt', turn, message: msg.message });
      running = true;
      write({ type: 'system', subtype: 'init', session_id: sessionId, cwd: dir, tools: [], mcp_servers: [{ name: 'pi', status: 'connected' }], model: arg('model'), permissionMode: arg('permission-mode'), apiKeySource: 'none', slash_commands: [], output_style: 'default', uuid: randomUUID() });
      void runTurn(script.turns[turn] ?? [{ text: 'ok' }]);
    }
  }
});
process.stdin.on('end', () => { log({ kind: 'exit' }); process.exit(0); });
