{
  "name": "@otto/server-core",
  "version": "0.1.0",
  "license": "Apache-2.0",
  "description": "Reusable headless server infrastructure for Otto",
  "type": "module",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./transport": "./src/transport/index.ts",
    "./runtime": "./src/runtime/index.ts",
    "./handlers": "./src/handlers/index.ts",
    "./bootstrap": "./src/bootstrap/index.ts",
    "./model-fetchers": "./src/model-fetchers/index.ts",
    "./domain": "./src/domain/index.ts",
    "./services": "./src/services/index.ts",
    "./services/vcredist": "./src/services/vcredist.ts",
    "./handlers/rpc": "./src/handlers/rpc/index.ts",
    "./handlers/rpc/*": "./src/handlers/rpc/*.ts",
    "./sessions": "./src/sessions/index.ts",
    "./webui": "./src/webui/index.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@ai-sdk/openai": "4.0.87",
    "@mastra/core": "1.75.0",
    "@mastra/libsql": "1.25.1",
    "@libsql/client": "0.18.0",
    "@otto/core": "workspace:*",
    "@otto/shared": "workspace:*",
    "ws": "^8.19.0",
    "sharp": "0.34.5",
    "pdfjs-dist": "5.4.296",
    "@napi-rs/canvas": "0.1.88",
    "@earendil-works/pi-ai": "0.87.1"
  },
  "devDependencies": {
    "typescript": "^5.8.2",
    "@types/node": "^22.0.0"
  }
}
