{
  "name": "@otto/server",
  "version": "0.1.0",
  "description": "Standalone headless Otto server (Bun runtime)",
  "type": "module",
  "main": "src/index.ts",
  "bin": {
    "otto-server": "src/index.ts"
  },
  "files": [
    "src/"
  ],
  "engines": {
    "bun": ">=1.0.0"
  },
  "author": {
    "name": "Gafaro",
    "email": "hello@hellogafaro.com"
  },
  "license": "Apache-2.0",
  "scripts": {
    "start": "bun run src/index.ts",
    "generate-token": "bun run src/index.ts --generate-token",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@otto/core": "workspace:*",
    "@otto/messaging-gateway": "workspace:*",
    "@otto/server-core": "workspace:*",
    "@otto/shared": "workspace:*"
  },
  "devDependencies": {
    "typescript": "^5.8.2",
    "@types/node": "^22.0.0",
    "ws": "^8.16.0"
  }
}
